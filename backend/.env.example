MONGO_URL=mongodb://localhost:27017
DB_NAME=smile_action_lab

# Copy the test keys from your Clerk project; never expose the secret key to frontend code.
CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key

# The backend also loads these integrations during startup.
EMERGENT_EMAIL_KEY=replace_with_your_email_integration_key
EMAIL_FROM_NAME=SMILE ACTION LAB
EMERGENT_LLM_KEY=replace_with_your_llm_integration_key

# Optional. SmileTalk uses local, materials-based replies unless a user opts in
# for an individual message. Keep this key in the backend only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CORS_ORIGINS=http://localhost:3000
ADMIN_EMAIL='lab.smileaction@gmail.com'
